{
  "name": "topical-hub",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Topical Hub: free, original exam-style topical practice questions for Cambridge IGCSE Chemistry 0620, Biology 0610 and Physics 0625, with mark schemes and worked solutions.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-pdfs.mjs && astro build && node scripts/check-dist.mjs",
    "pdfs": "node scripts/generate-pdfs.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:render": "node scripts/audit-render.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "astro": "^7.3.8",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
