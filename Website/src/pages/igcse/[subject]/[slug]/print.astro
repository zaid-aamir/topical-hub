---
/**
 * Printable questions: /igcse/<subject>/<slug>/print/
 *
 * Every question of the topic without any answer, with ruled answer space under each structured
 * part. noindex; the layout drops the site header for body.print-page and print.css hides the
 * footer and the one button when printing. The print-only watermark comes from PrintWatermark.astro.
 * `npm run pdfs` prints this page to the downloadable questions PDF.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PrintQuestion from '../../../../components/question/PrintQuestion.astro';
import { countsSentence, pageName, pageNameWithTopic } from '../../../../components/question/labels';
import { subjectPages } from '../../../../lib/subjects';
import PrintWatermark from '../../../../components/PrintWatermark.astro';
import { SITE_NAME, SUBJECTS } from '../../../../config';
import { pdfDownload } from '../../../../lib/pdfs';

export const getStaticPaths = (() =>
  SUBJECTS.flatMap((subject) => subjectPages(subject).map((topic) => ({ params: { subject: subject.path.split('/')[1], slug: topic.slug }, props: { topic, subject } })))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { topic, subject } = Astro.props;
const topicPath = `/${subject.path}/${topic.slug}/`;
const path = `${topicPath}print/`;
const pdf = pdfDownload(topic.slug, 'questions', subject.path);
const title = `${pageName(topic)} — printable questions | ${SITE_NAME}`;
const description =
  `Printable sheet of the ${topic.counts.total} exam-style questions on ${pageNameWithTopic(topic)} for ${subject.fullName}, ` +
  `with ruled answer space and without the answers. The mark scheme prints separately.`;
---
<BaseLayout title={title} description={description} canonicalPath={path} noindex bodyClass="print-page">
  <PrintWatermark slot="overlay" />
  <div class="shell">
    <div class="measure">
      <div class="page-title">
        <p class="page-label">{SITE_NAME}, {subject.shortName} exam-style questions</p>
        <h1>{pageName(topic)}</h1>
        <p class="page-summary">{countsSentence(topic.counts)}.</p>
      </div>

      <div class="print-actions">
        <button class="button" type="button" onclick="window.print()">Print this page</button>
        <a href={pdf.href} download>{pdf.text}</a>
        <a href={topicPath}>Back to the topic page</a>
        <a href={`${topicPath}print-answers/`}>Print the mark scheme</a>
      </div>

      <div class="question-list">
        {topic.questions.map((question) => <PrintQuestion subject={subject} question={question} />)}
      </div>
    </div>
  </div>
</BaseLayout>
