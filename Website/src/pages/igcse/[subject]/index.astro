---
/**
 * Subject home: the topic cards of one subject in SUBJECTS, with counts computed from the data.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopicGrid from '../../../components/TopicGrid.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { subjectPages, subjectTopics } from '../../../lib/subjects';
import { SITE_NAME, SUBJECTS, syllabusPhrase } from '../../../config';

export function getStaticPaths() {
  return SUBJECTS.map((subject) => ({ params: { subject: subject.path.split('/')[1] }, props: { subject } }));
}
const { subject } = Astro.props;
const topics = subjectTopics(subject);
const pages = subjectPages(subject);
// Consecutive whole-topic pages share one grid; a split topic gets its own heading and grid.
const sections: { topic?: (typeof topics)[number]; pages: typeof pages }[] = [];
for (const page of pages) {
  const last = sections.at(-1);
  const split = page.pageTitle !== undefined;
  if (last && (split ? last.topic?.topicId === page.topicId : last.topic === undefined)) last.pages.push(page);
  else sections.push({ topic: split ? topics.find((t) => t.topicId === page.topicId) : undefined, pages: [page] });
}
const totalQuestions = topics.reduce((sum, topic) => sum + topic.counts.total, 0);
const topicCount = topics.length;
const subjectPath = `/${subject.path}/`;

const title = `${subject.shortName} exam-style questions by topic, with answers | ${SITE_NAME}`;
const description =
  `${totalQuestions} original exam-style questions for ${subject.fullName} in ${topicCount} topics, ` +
  `each with a mark scheme and a worked solution. Free, with ${subject.tiers.filterSummary}.`;
---
<BaseLayout title={title} description={description} canonicalPath={subjectPath}>
  <div class="shell">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: subject.shortName, href: subjectPath }]} />
    <div class="page-title">
      <p class="page-label">{subject.fullName}, {syllabusPhrase(subject)}</p>
      <h1>{subject.shortName}</h1>
      <p class="page-summary">
        {totalQuestions} original exam-style questions across {topicCount} topics, with mark schemes and worked
        solutions.
      </p>
    </div>

    {
      sections.map((section) =>
        section.topic ? (
          <section class="topic-group" aria-labelledby={`topic-${section.topic.topicId}`}>
            <h2 class="topic-group-heading" id={`topic-${section.topic.topicId}`}>
              <span class="topic-group-number">{section.topic.topicNumber}</span> {section.topic.topicName}
            </h2>
            <TopicGrid subject={subject} topics={section.pages} />
          </section>
        ) : (
          <TopicGrid subject={subject} topics={section.pages} />
        ),
      )
    }

    <div class="prose">
      <p>
        Choose a topic to see its questions. On a topic page you can filter by {subject.tiers.filterBy} and by question
        type, attempt a question, then reveal its mark scheme and worked solution. Each topic also has two print
        pages for practice on paper: the questions with ruled answer space, and the mark scheme. The questions
        are original, written with AI tools and approved by the site owner; <a href="/about/">more about the site</a>.
      </p>
    </div>
  </div>
</BaseLayout>
