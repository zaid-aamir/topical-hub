---
/**
 * Home page: what the site is, in plain words, then one card per subject (SUBJECTS in config.ts).
 * Topics are listed only on each subject's own page, so there is one route to them however many
 * subjects there are. Counts are computed from the data at build time.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubjectGrid from '../components/SubjectGrid.astro';
import { SITE_NAME, SITE_TAGLINE, SOLE_SUBJECT } from '../config';

// While there is one subject the title names it (good for search); with more it is generic.
const title = SOLE_SUBJECT
  ? `${SITE_NAME}: free ${SOLE_SUBJECT.shortName} exam-style questions with answers`
  : `${SITE_NAME}: free exam-style topical questions with answers`;
const writtenFor = SOLE_SUBJECT
  ? `the ${SOLE_SUBJECT.fullName} papers for the ${SOLE_SUBJECT.syllabusYears} syllabus`
  : 'the exam papers of each subject’s current syllabus';
---
<BaseLayout title={title} description={SITE_TAGLINE} canonicalPath="/">
  <div class="shell">
    <div class="page-title home-title">
      <h1>{SITE_NAME}</h1>
      <p class="page-summary lead">{SITE_TAGLINE}.</p>
    </div>

    <div class="prose">
      <p>
        The questions are original exam-style questions, written in the style of {writtenFor}. They were written
        and checked with AI tools, not by teachers or examiners, so mistakes are possible: if anything looks
        wrong, use the Report an error link under that question.
      </p>
      <p>
        Every question has a mark scheme and a worked solution, hidden until you choose to look. The site is free
        and has no accounts. <a href="/about/">More about the site</a>.
      </p>
    </div>

    <section id="subjects" aria-labelledby="subjects-heading">
      <h2 class="home-subjects-heading" id="subjects-heading">Subjects</h2>
      <SubjectGrid />
    </section>
  </div>
</BaseLayout>

<style>
  /* Home page only: the title page of the booklet. A larger serif title, a lead sentence,
     and room above the subjects heading. Everything else is the shared system. */
  .home-title {
    margin-top: var(--space-4);
  }

  .home-title h1 {
    font-size: clamp(2.25rem, 1.75rem + 2.4vw, 3.25rem);
  }

  .lead {
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.375rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .home-subjects-heading {
    margin-top: var(--space-10);
  }

  /* The header's "Subjects" link jumps here; keep the heading clear of the top edge. */
  #subjects {
    scroll-margin-top: var(--space-4);
  }
</style>