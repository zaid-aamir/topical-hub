---
/**
 * Base layout for every page. Props per CONTRACT.md.
 *
 * - Fonts are self-hosted through @fontsource (no third-party requests at runtime).
 * - The inline script in <head> applies a stored theme choice before first paint.
 * - Print pages (bodyClass containing "print-page", or chrome={false}) get no header navigation;
 *   the footer with the disclaimer stays on every page.
 */
import '@fontsource/newsreader/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/print.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { GOOGLE_SITE_VERIFICATION, SITE_NAME, SITE_URL } from '../config';

interface Props {
  /** Full document title, e.g. "About Topical Hub". */
  title: string;
  /** Meta description, unique per page. */
  description: string;
  /** Path of this page with leading slash, e.g. "/about/". Joined to SITE_URL for the canonical URL. */
  canonicalPath: string;
  /** Adds <meta name="robots" content="noindex">. Used by the print pages and the 404 page. */
  noindex?: boolean;
  /** Class(es) for <body>, e.g. "print-page". */
  bodyClass?: string;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** Set false to leave out the site header (navigation). Implied by bodyClass "print-page". */
  chrome?: boolean;
}

const { title, description, canonicalPath, noindex = false, bodyClass, ogType = 'website', chrome } = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
const showHeader = chrome ?? !/\bprint-page\b/.test(bodyClass ?? '');

// Paper colours from tokens.css, for the browser UI before CSS loads (keep in step with --paper).
// The theme toggle then reads --paper itself.
const LIGHT_PAPER = '#f5f7f7';
const DARK_PAPER = '#111a1b';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored theme choice before first paint. The toggle stores "light" or "dark".
      try {
        var storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.dataset.theme = storedTheme;
        }
      } catch (error) {
        // Storage unavailable: follow the system preference.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={LIGHT_PAPER} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={DARK_PAPER} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {showHeader && <SiteHeader />}
    <main id="main" class="site-main">
      <slot />
    </main>
    <SiteFooter />
    <slot name="overlay" />
  </body>
</html>
