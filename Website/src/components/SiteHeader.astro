---
/**
 * Site header: wordmark (to the home page), a "Subjects" link to the home page's subject list,
 * theme toggle. Rendered by BaseLayout on every page except the print pages.
 */
import ThemeToggle from './ThemeToggle.astro';
import { SITE_NAME } from '../config';

const onHome = Astro.url.pathname.replace(/index\.html$/, '') === '/';
---
<header class="site-header">
  <div class="shell site-header-inner">
    <a class="wordmark" href="/">{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Main">
      <a class="site-nav-link" href="/#subjects" aria-current={onHome ? 'page' : undefined}>Subjects</a>
      <ThemeToggle />
    </nav>
  </div>
</header>