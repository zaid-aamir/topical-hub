---
/**
 * Site header: wordmark, link to the one subject, theme toggle.
 * Rendered by BaseLayout on every page except the print pages.
 */
import ThemeToggle from './ThemeToggle.astro';
import { SITE_NAME, SUBJECT } from '../config';

const subjectPath = `/${SUBJECT.path}/`;
const here = Astro.url.pathname.replace(/\/+$/, '');
const onSubjectPage = here === subjectPath.replace(/\/+$/, '');
---
<header class="site-header">
  <div class="shell site-header-inner">
    <a class="wordmark" href="/">{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Main">
      <a class="site-nav-link" href={subjectPath} aria-current={onSubjectPage ? 'page' : undefined}>
        {SUBJECT.shortName}
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
