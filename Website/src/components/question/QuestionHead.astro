---
/**
 * Card head for both print pages (the topic page draws its own in QuestionCard): the question numeral (an h2 so the
 * h3s inside the answer panel keep the heading order), the tier badge, the sub-topic name and the
 * total marks in square brackets, as on a paper.
 */
import type { Question } from '../../content';
import type { TierWording } from '../../config';
import TierBadge from './TierBadge.astro';

interface Props {
  question: Question;
  tiers: TierWording;
}

const { question, tiers } = Astro.props;
---
<div class="question-head">
  <h2 class="question-number"><span class="visually-hidden">Question </span>{question.number}{question.part !== undefined && <span class="question-part"> · Part {question.part}</span>}</h2>
  <TierBadge tier={question.tier} wording={tiers} />
  <span class="subtopic">{question.subtopicName}</span>
  <span class="marks">[{question.marks}]</span>
</div>
