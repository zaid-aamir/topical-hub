---
/**
 * One question on the topic page: article.question.question-card#<anchor> with the data attributes
 * the filters, the script, the styles and the tests key on (CONTRACT.md, "DOM contract").
 * Everything a student can read is in the HTML at build time; the answer panel is hidden until
 * opened.
 *
 * - The head is the numeral, the tier and marks badges and the sub-topic. No per-question part
 *   label: merged topics get a part heading on the topic page instead.
 * - data-answer (MCQ only) lets the script mark an option without any lookup.
 * - The stem has id <anchor>-stem so the option group can be labelled by it.
 * - The report link (only when REPORT_FORM_URL is set) carries the question id and the absolute URL of this anchor.
 */
import type { Question } from '../../content';
import { SITE_URL, reportErrorUrl } from '../../config';
import { mdBlock, subjectFormat } from '../../lib/markdown';
import McqOptions from './McqOptions.astro';
import StructuredParts from './StructuredParts.astro';
import AnswerPanel from './AnswerPanel.astro';
import { marksLabel } from './labels';
import TierBadge from './TierBadge.astro';

import type { Subject } from '../../config';
import { questionAnchor } from '../../lib/question-anchor';

interface Props {
  subject: Subject;
  question: Question;
  /** Topic slug, for the absolute URL in the report link. */
  slug: string;
}

const { question, slug, subject } = Astro.props;
const anchor = questionAnchor(question, subject);
const format = subjectFormat(subject);
const stemId = `${anchor}-stem`;
const panelId = `${anchor}-answer`;
const isMcq = question.type === 'mcq';
const reportHref = reportErrorUrl(question.id, `${SITE_URL}/${subject.path}/${slug}/#${anchor}`);
---
<article
  class="question question-card"
  id={anchor}
  data-question-id={question.id}
  data-tier={question.tier}
  data-type={question.type}
  data-subtopic={question.subtopicId}
  data-number={question.number}
  data-answer={question.type === 'mcq' ? question.answer : undefined}
>
  <div class="question-head">
    <h2 class="question-number"><span class="visually-hidden">Question </span>{question.number}</h2>
    <TierBadge tier={question.tier} wording={subject.tiers} />
    <span class="badge badge-marks">{marksLabel(question.marks)}</span>
    <span class="subtopic">{question.subtopicName}</span>
  </div>
  <div class="question-body">
    {question.stem !== '' && <div class="stem" id={stemId} set:html={mdBlock(question.stem, format)} />}
    {question.type === 'mcq' ? <McqOptions format={format} question={question} stemId={stemId} /> : <StructuredParts format={format} question={question} />}
  </div>
  {isMcq && <p class="feedback" role="status" aria-live="polite"></p>}
  <div class="question-actions">
    {isMcq && <button class="try-again" type="button" hidden>Try again</button>}
    <button class="toggle-answer" type="button" aria-expanded="false" aria-controls={panelId}>
      <span class="toggle-label">{isMcq ? 'Show answer' : 'Show mark scheme'}</span>
      <svg class="chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    {
      reportHref !== null && (
        <a class="report-link" href={reportHref} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M3.5 14.5v-12M3.5 2.5h8l-2 3 2 3h-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Report an error
        </a>
      )
    }
  </div>
  <div class="answer" id={panelId} hidden>
    <AnswerPanel format={format} question={question} />
  </div>
</article>
