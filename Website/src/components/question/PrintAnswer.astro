---
/**
 * One question on the printable mark scheme: the head (number, tier, sub-topic, marks) and the
 * same answer panel the topic page shows, always visible. id="q<n>" keeps the numbering aligned
 * with the questions sheet and lets the render audit locate each entry.
 */
import type { Question } from '../../content';
import QuestionHead from './QuestionHead.astro';
import AnswerPanel from './AnswerPanel.astro';

import type { Subject } from '../../config';
import { questionAnchor } from '../../lib/question-anchor';
import { subjectFormat } from '../../lib/markdown';

interface Props {
  subject: Subject;
  question: Question;
}

const { question, subject } = Astro.props;
const anchor = questionAnchor(question, subject);
const format = subjectFormat(subject);
---
<article
  class="question"
  id={anchor}
  data-question-id={question.id}
  data-tier={question.tier}
  data-type={question.type}
  data-number={question.number}
>
  <QuestionHead question={question} tiers={subject.tiers} />
  <div class="question-body">
    <AnswerPanel format={format} question={question} />
  </div>
</article>
